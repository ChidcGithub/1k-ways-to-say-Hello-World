---
import { codeToHtml } from 'shiki';
import CopyButton from './CopyButton.astro';

interface Props {
	code: string;
	lang: string;
	fileName?: string;
	labelCopy: string;
	labelCopied: string;
	labelCopiedData?: string;
}

const { code, lang, fileName, labelCopy, labelCopied } = Astro.props;

let highlighted = '';
try {
	highlighted = await codeToHtml(code, {
		lang: lang || 'plaintext',
		themes: {
			light: 'github-light',
			dark: 'github-dark',
		},
	});
} catch {
	highlighted = await codeToHtml(code, {
		lang: 'plaintext',
		themes: {
			light: 'github-light',
			dark: 'github-dark',
		},
	});
}
---

<div class="code-block">
	{
		fileName && (
			<div class="code-header">
				<span>{fileName}</span>
				<CopyButton target={code} labelCopy={labelCopy} labelCopied={labelCopied} />
			</div>
		)
	}
	<div class="code-body" set:html={highlighted} />
	{
		!fileName && (
			<div class="code-float-copy">
				<CopyButton target={code} labelCopy={labelCopy} labelCopied={labelCopied} />
			</div>
		)
	}
</div>

<style>
	.code-body :global(pre) {
		margin: 0;
		padding: 18px 20px;
		overflow-x: auto;
		line-height: 1.6;
		font-size: 13.5px;
		font-family: var(--mono);
	}

	.code-body :global(code) {
		font-family: var(--mono);
		background: transparent !important;
	}

	.code-float-copy {
		position: absolute;
		top: 10px;
		right: 10px;
		z-index: 2;
	}
</style>
