---
import type { Locale } from '../lib/types';
import { dictionaries } from '../i18n/dictionaries';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title: string;
	description?: string;
}

const { locale, title, description } = Astro.props;
const d = dictionaries[locale];
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hello-worlds.vercel.app');
const lang = locale === 'zh' ? 'zh-CN' : 'en';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description ?? d.meta.description} />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description ?? d.meta.description} />
		<meta property="og:url" content={canonical.href} />
		<meta name="theme-color" content="#fff8ec" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1b1b23" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<NavBar locale={locale} currentPath={Astro.url.pathname} />
		<main>
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
