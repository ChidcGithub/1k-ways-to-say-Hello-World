---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContributeContent from '../../../components/content/Contribute.astro';
import { dictionaries } from '../../../i18n/dictionaries';

const locale = 'en' as const;
const d = dictionaries[locale];
---

<BaseLayout locale={locale} title={d.seo.contributeTitle} description={d.seo.contributeDesc}>
	<ContributeContent locale={locale} />
</BaseLayout>
