---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExploreContent from '../../../components/content/Explore.astro';
import { dictionaries } from '../../../i18n/dictionaries';

const locale = 'en' as const;
const d = dictionaries[locale];
---

<BaseLayout locale={locale} title={d.seo.exploreTitle} description={d.seo.exploreDesc}>
	<ExploreContent locale={locale} />
</BaseLayout>
